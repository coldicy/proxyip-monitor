# Proxy Monitor 环境变量配置示例

# 基础配置
NODE_ENV=production
PORT=8787
DATA_DIR=/app/data

# 检测配置
INTERVAL_SEC=60
CONCURRENCY=50
TIMEOUT_SEC=5
PROBE_URL=https://www.cloudflare.com/cdn-cgi/trace

# 测速配置
SPEED_ENABLED=true
SPEED_URL=https://speed.cloudflare.com/__down?bytes=20000000
SPEED_TIMEOUT_SEC=10
SPEED_MIN_MBPS=0
SPEED_CONCURRENCY=1
SPEED_PER_CYCLE=20

# 质量评估配置
QUALITY_WINDOW=10
SUCCESS_THRESHOLD=1
QUAL_THRESHOLD=1
MAX_TOTAL_MS=0
AUTO_CLEAN_DAYS=7

# 自定义探针 (JSON 格式)
# CUSTOM_PROBES='[{"url":"https://www.google.com","expect":"200"},{"url":"https://www.github.com","expect":"200"}]'

# GitHub 上传配置 (可选)
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPO=username/proxy-ips
# GITHUB_BRANCH=main
